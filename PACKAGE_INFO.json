{
  "package_name": "vd10_experiment_task_workflow",
  "display_name": "VD10 实验任务编排台",
  "version": "0.3.0",
  "owner_module": "VD10 实验任务编排与执行模拟",
  "entrypoint": "index.html",
  "default_url": "http://localhost:8877",
  "runtime": {
    "frontend_dependencies": [],
    "local_server": "FastAPI and Uvicorn",
    "python_environment": ".venv",
    "asr_provider": "Tencent Cloud realtime WebSocket ASR with SentenceRecognition fallback",
    "browser_audio_format": "16kHz mono PCM stream; WAV in fallback mode",
    "mqtt_client": "paho-mqtt",
    "mqtt_topics": [
      "autolab/ui/input",
      "autolab/semantic/params",
      "autolab/planner/result",
      "autolab/physical/validation"
    ],
    "mqtt_ui_input_optional_fields": [
      "asrTiming"
    ],
    "mqtt_history": "data/mqtt_history/YYYY-MM-DD.jsonl"
  },
  "source_data": {
    "operation_tree": "data/vd10_agent_only_operation_tree.json",
    "meta_operation_library": "data/meta-operations.json",
    "meta_operation_schema": "schemas/meta-operation-library.schema.json",
    "spatial_location_library": "data/spatial-locations.json",
    "spatial_location_schema": "schemas/spatial-location-library.schema.json",
    "spatial_locations": 5,
    "transport_links": 1,
    "building_floors": 3,
    "atomic_vd10_capabilities": 16,
    "instrument_groups": 10,
    "instrument_meta_operations": 25,
    "robot_meta_operations": 63,
    "laboratory_meta_operations": 5,
    "total_meta_operations": 93,
    "single_action_operations": 55,
    "legacy_composite_operations": 38,
    "robot_action_templates": "data/robot-action-templates.json"
  },
  "handoff": {
    "format_status": "prototype_meta_operation_handoff",
    "required_files": [
      "data/meta-operations.json",
      "data/robot-action-templates.json",
      "docs/ROBOT_ACTION_CAPABILITIES.md",
      "schemas/meta-operation-library.schema.json",
      "schemas/semantic-params.schema.json",
      "schemas/planner-result.schema.json",
      "schemas/physical-validation.schema.json",
      "data/spatial-locations.json",
      "schemas/spatial-location-library.schema.json",
      "data/vd10_agent_only_operation_tree.json",
      "docs/META_OPERATION_SPEC.md",
      "docs/META_OPERATION_HANDOFF.md",
      "docs/MODULE_INTERFACE_HANDOFF.md",
      "knowledge/planner_scenarios/leather_extraction.json",
      "schemas/conditional-workflow.schema.json",
      "data/leather-extraction-resources.json",
      "docs/LEATHER_EXTRACTION.md",
      "knowledge/planner_scenarios/registry.json",
      "knowledge/planner_scenarios/sample_hold.json",
      "schemas/process-scenario.schema.json",
      "docs/CONFIGURED_WORKFLOWS.md"
    ],
    "legacy_schema": "schemas/agan_vd10_handoff.schema.json",
    "legacy_schema_compatible": false,
    "confidence_included": false,
    "physical_execution_included": false,
    "simulation_only": true
  }
}
