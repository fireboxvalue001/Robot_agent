# Copy to server.env ON THE SERVER, then chmod 600. Never commit real credentials.
# Empty keys intentionally disable paid services until explicitly configured.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_APP_ID=
TENCENT_ASR_ENGINE=16k_zh
TENCENTCLOUD_REGION=
TENCENT_ASR_WORD_INFO=1
TENCENT_ASR_VAD_SILENCE_TIME=800
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
DOCUMENT_INTENT_API_KEY=
DOCUMENT_INTENT_BASE_URL=
DOCUMENT_INTENT_MODEL=
DOCUMENT_INTENT_TIMEOUT_SECONDS=120
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# compose.json FORCES MQTT off, even if this value is changed.
# Real MQTT requires a separately reviewed integration configuration.
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
