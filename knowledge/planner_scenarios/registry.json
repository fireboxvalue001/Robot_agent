{
  "schema_version": "1.0.0",
  "scenarios": [
    {
      "id": "vd10_single_sample_demo",
      "name": "VD10单样品检测",
      "engine": "legacy_linear",
      "file": "knowledge/planner_scenarios/vd10_single_sample.json",
      "enabled": true,
      "routing_patterns": [
        "VD10"
      ],
      "ui": {
        "handoff_required": true,
        "parameter_mode": "sample"
      },
      "routing_exclusions": [
        "VD10.*(?:屏幕|界面).*(?:填写|准备)",
        "VD10.*(?:屏幕|界面).*(?:查询|检索)",
        "VD10.*(?:屏幕|界面).*(?:质量|质控)",
        "(?:VD10.*机械臂|机械臂.*VD10).*触屏.*(?:质量|质控)"
      ]
    },
    {
      "id": "liquid_transfer_demo",
      "name": "容器间定量移液",
      "engine": "legacy_linear",
      "file": "knowledge/planner_scenarios/liquid_transfer.json",
      "enabled": true,
      "routing_patterns": [
        "^从.+（容器编号：.+）中吸取.+液体，加入.+（容器编号：.+）中[。.]?$"
      ],
      "ui": {
        "handoff_required": false,
        "parameter_mode": "resolved_text",
        "read_results": false
      }
    },
    {
      "id": "leather_fat_extraction",
      "name": "皮革油脂抽提",
      "engine": "conditional",
      "file": "knowledge/planner_scenarios/leather_extraction.json",
      "scope_catalog": "knowledge/planner_scenarios/leather_scope.json",
      "enabled": true,
      "routing_patterns": [
        "皮革",
        "索氏",
        "油脂(?:提取|抽提)",
        "二氯甲烷"
      ],
      "ui": {
        "handoff_required": false,
        "parameter_mode": "process"
      }
    },
    {
      "id": "sample_hold_config",
      "name": "样品定时静置",
      "engine": "conditional",
      "file": "knowledge/planner_scenarios/sample_hold.json",
      "enabled": true,
      "routing_patterns": [
        "样品定时静置",
        "静置登记示例"
      ],
      "ui": {
        "handoff_required": false,
        "parameter_mode": "process"
      }
    },
    {
      "id": "vd10_screen_prepare",
      "name": "VD10屏幕测试信息填写",
      "engine": "conditional",
      "enabled": true,
      "file": "knowledge/planner_scenarios/vd10_screen_prepare.json",
      "routing_patterns": [
        "VD10.*(?:屏幕|界面).*(?:填写|准备)"
      ],
      "ui": {
        "handoff_required": false,
        "parameter_mode": "process"
      }
    },
    {
      "id": "vd10_screen_query",
      "name": "VD10屏幕历史结果查询",
      "engine": "conditional",
      "enabled": true,
      "file": "knowledge/planner_scenarios/vd10_screen_query.json",
      "routing_patterns": [
        "VD10.*(?:屏幕|界面).*(?:查询|检索)"
      ],
      "ui": {
        "handoff_required": false,
        "parameter_mode": "process"
      }
    },
    {
      "id": "vd10_screen_quality",
      "name": "VD10屏幕质量状态查看",
      "engine": "conditional",
      "enabled": true,
      "file": "knowledge/planner_scenarios/vd10_screen_quality.json",
      "routing_patterns": [
        "VD10.*(?:屏幕|界面).*(?:质量|质控)"
      ],
      "routing_exclusions": [
        "机械臂.*触屏"
      ],
      "ui": {
        "handoff_required": false,
        "parameter_mode": "process"
      }
    },
    {
      "id": "vd10_screen_robot_quality",
      "name": "VD10机械臂触屏质量状态查看",
      "engine": "conditional",
      "enabled": true,
      "file": "knowledge/planner_scenarios/vd10_screen_robot_quality.json",
      "routing_patterns": [
        "(?:VD10.*机械臂|机械臂.*VD10).*触屏.*(?:质量|质控)"
      ],
      "ui": {
        "handoff_required": false,
        "parameter_mode": "process"
      }
    }
  ]
}
