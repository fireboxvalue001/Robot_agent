{
  "scenario_id": "vd10_screen_prepare",
  "name": "VD10屏幕测试信息填写",
  "knowledge_id": "autolab.planner.vd10_screen_prepare",
  "version": "0.2.1",
  "review_status": "draft",
  "scope": "VD10屏幕测试信息填写；只允许组合既有C2能力，不启动检测、不删除、不校准、不退出或关机。",
  "source": "data/meta-operations.json中的既有能力及原VD10说明书节点；不是新增硬件接口定义",
  "entry": "start",
  "resource_file": "data/vd10-screen-resources.json",
  "phases": [
    {
      "id": "start",
      "label": "任务入口"
    },
    {
      "id": "phase_1",
      "label": "1. VD10测试信息准备"
    },
    {
      "id": "exception",
      "label": "异常复核",
      "exception": true
    }
  ],
  "parameters": {
    "sample_id": {
      "type": "string",
      "label": "样品编号",
      "anchors": [
        "样品编号"
      ],
      "maxLength": 200
    },
    "operator": {
      "type": "string",
      "label": "操作员",
      "anchors": [
        "操作员"
      ],
      "maxLength": 200
    }
  },
  "nodes": [
    {
      "id": "start",
      "kind": "start",
      "label": "任务入口",
      "phase_id": "start",
      "requires": [],
      "next": "step_1"
    },
    {
      "id": "step_1",
      "kind": "action",
      "label": "VD10测试信息准备",
      "phase_id": "phase_1",
      "requires": [
        "sample_id",
        "operator"
      ],
      "operation_id": "vd10.meta.prepare_test",
      "input_bindings": {
        "sample_id": {
          "parameter_ref": "sample_id"
        },
        "operator": {
          "parameter_ref": "operator"
        }
      },
      "outputs": [
        "form_state",
        "verified"
      ],
      "next": "check_1",
      "on_error": "review",
      "on_timeout": "review",
      "display": {
        "title": "VD10测试信息准备",
        "fields": [
          {
            "argument": "sample_id",
            "label": "样品编号"
          },
          {
            "argument": "operator",
            "label": "操作员"
          }
        ],
        "notice": "直接引用已有C2能力；多内部节点条目仍为历史组合，不是新定义的单步动作。"
      }
    },
    {
      "id": "check_1",
      "kind": "guard",
      "label": "核验能力反馈",
      "phase_id": "phase_1",
      "requires": [],
      "data_refs": [
        "step_1.form_state"
      ],
      "check": {
        "operation_id": "vd10.meta.prepare_test",
        "required_outputs": [
          "form_state"
        ]
      },
      "on_pass": "complete",
      "on_fail": "review",
      "on_error": "review",
      "on_timeout": "review"
    },
    {
      "id": "complete",
      "kind": "end",
      "label": "流程结束 尚未执行",
      "phase_id": "phase_1",
      "requires": []
    },
    {
      "id": "review",
      "kind": "end",
      "label": "停止任务并人工复核",
      "phase_id": "exception",
      "requires": []
    }
  ],
  "blocked_request_patterns": [
    {
      "pattern": "(?<!不)(?<!不要)(?:启动|开始)(?:VD10)?(?:检测|测试)|(?<!不)(?<!不要)删除.*结果|(?<!不)(?<!不要)校准|(?<!不)(?<!不要)关机|(?<!不)(?<!不要)退出",
      "message": "该场景只支持已登记屏幕交互，不支持启动检测、删除、校准、退出或关机。"
    }
  ],
  "limits": {
    "max_automatic_retries": 0,
    "execution_allowed": false
  }
