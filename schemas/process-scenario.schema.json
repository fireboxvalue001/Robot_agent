{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Configured logical process scenario",
  "type": "object",
  "required": ["scenario_id", "name", "knowledge_id", "version", "review_status", "scope", "source", "entry", "phases", "parameters", "nodes"],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
    "name": {"type": "string", "minLength": 1},
    "knowledge_id": {"type": "string", "minLength": 1},
    "version": {"type": "string"}, "source": {"type": "string"},
    "review_status": {"enum": ["draft", "approved"]}, "scope": {"type": "string"},
    "entry": {"type": "string"}, "resource_file": {"type": "string"},
    "phases": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "label"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "exception": {"type": "boolean"}, "diagram": {"type": "object"}}}},
    "parameters": {"type": "object", "additionalProperties": {
      "type": "object", "required": ["label"],
      "properties": {"label": {"type": "string"}, "type": {"enum": ["number", "string", "boolean"]}, "unit": {"type": "string"}, "required": {"type": "boolean"}, "enum": {"type": "array", "minItems": 1}, "minimum": {"type": "number"}, "maximum": {"type": "number"}, "integer": {"type": "boolean"}, "anchors": {"type": "array", "items": {"type": "string"}}}
    }},
    "method_requirements": {"type": "array", "items": {"type": "object", "required": ["id", "collection", "selection_label", "clarification"], "properties": {
      "id": {"type": "string"}, "collection": {"type": "string"}, "selection_label": {"type": "string"},
      "clarification": {"type": "object", "required": ["described_label", "missing_label", "described_instruction", "missing_instruction", "review_notice"]}
    }}},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "kind", "label", "phase_id", "requires"], "properties": {
      "id": {"type": "string"}, "kind": {"enum": ["start", "action", "wait", "guard", "decision", "loop_check", "monitored_hold", "compute", "end"]},
      "label": {"type": "string"}, "phase_id": {"type": "string"}, "requires": {"type": "array", "items": {"type": "string"}}, "display": {"type": "object"}
    }}}
  }
}
