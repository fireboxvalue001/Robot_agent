{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autolab.local/schemas/document-intent.schema.json",
  "title": "Normalized laboratory document intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "document_id", "intent", "sample", "tests", "instruments",
    "report_requirements", "constraints", "unresolved", "confidence", "capability_assessment"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_id": {"type": "string", "minLength": 1},
    "intent": {"enum": ["oil_testing_request", "unknown"]},
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oil_name", "oil_type", "sample_no", "quantity_text", "container_count", "total_volume_ml"],
      "properties": {
        "oil_name": {"type": ["string", "null"]},
        "oil_type": {"type": ["string", "null"]},
        "sample_no": {"type": ["string", "null"]},
        "quantity_text": {"type": ["string", "null"]},
        "container_count": {"type": ["number", "null"], "minimum": 0},
        "total_volume_ml": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "standard", "remark"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "standard": {"type": ["string", "null"]},
          "remark": {"type": ["string", "null"]}
        }
      }
    },
    "instruments": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "report_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifiers", "delivery_time", "delivery_method", "notes"],
      "properties": {
        "identifiers": {"type": "array", "items": {"type": "string"}},
        "delivery_time": {"type": ["string", "null"]},
        "delivery_method": {"type": ["string", "null"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "constraints": {"type": "array", "items": {"type": "string"}},
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "capability_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matched_instruments", "supported_tests", "unsupported_tests", "routing_status"],
      "properties": {
        "matched_instruments": {"type": "array", "items": {"type": "string"}},
        "supported_tests": {"type": "array", "items": {"type": "string"}},
        "unsupported_tests": {"type": "array", "items": {"type": "string"}},
        "routing_status": {"enum": ["matched", "needs_routing"]}
      }
    }
  }
}
